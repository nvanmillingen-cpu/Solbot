# ─── Wallet ──────────────────────────────────────────────────────────────
# Private key van een APARTE wallet met een klein bedrag (nooit je hoofdwallet!).
# Phantom: Instellingen → Beheer accounts → [account] → Privésleutel tonen (base58).
# Een JSON-array ([12,34,...]) zoals uit solana-keygen werkt ook.
# Leeg laten = alleen paper mode mogelijk.
PRIVATE_KEY=

# ─── RPC ─────────────────────────────────────────────────────────────────
# Publieke endpoint werkt voor paper mode, maar is traag en streng gelimiteerd.
# Aanbevolen: gratis tier van Helius (https://helius.dev) of QuickNode.
RPC_URL=https://api.mainnet-beta.solana.com
# Optioneel: websocket-URL van dezelfde provider (anders afgeleid van RPC_URL)
RPC_WS_URL=

# ─── Live trading-slot ───────────────────────────────────────────────────
# Extra beveiliging: alleen als dit "true" is kan paper mode in het dashboard
# uitgezet worden. Laat op false tot je paper mode goed getest hebt.
LIVE_TRADING_ENABLED=false

# ─── Optionele API-sleutels ──────────────────────────────────────────────
# Jupiter: lite-api.jup.ag werkt zonder sleutel. Heb je een (gratis) sleutel van
# portal.jup.ag, vul dan JUPITER_API_URL=https://api.jup.ag en de sleutel in.
JUPITER_API_URL=https://lite-api.jup.ag
JUPITER_API_KEY=

# PumpPortal: nieuwe tokens zijn gratis. Met een API-sleutel (wallet met ≥0,02 SOL
# bij PumpPortal) krijgt de bot ook per-token trades → exact volume en holders.
PUMPPORTAL_API_KEY=

# ─── Dashboard ───────────────────────────────────────────────────────────
# 127.0.0.1 = alleen bereikbaar vanaf deze computer (aanbevolen, er is geen login).
HOST=127.0.0.1
PORT=3000

# ─── Overig ──────────────────────────────────────────────────────────────
DB_PATH=./data/solbot.db
LOG_DIR=./logs
# debug | info | warn | error
LOG_LEVEL=info
